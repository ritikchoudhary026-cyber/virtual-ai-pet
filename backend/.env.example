# Mode: offline, online, or auto (online with offline fallback)
DEFAULT_MODE=auto

# Offline engine (Phi-3 GGUF)
PHI_MODEL_PATH=models/Phi-3-mini-4k-instruct-q4.gguf

# Online engine (Nemotron 3.5 Lightning via OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning
OPENROUTER_TIMEOUT=15
OPENROUTER_MAX_RETRIES=2

# Memory
CHROMA_DB_PATH=./chroma_db
